# 複製成 .env 再修改：cp .env.example .env

# ===== 映像檔來源 =====
# Harbor 位址加上 Docker Hub 代理專案名稱，例如 harbor.mycompany.com/dockerhub
REGISTRY=harbor.mycompany.com/dockerhub
# 固定版本，不要用 latest
WEKNORA_VERSION=v0.8.2

# ===== 基本 =====
GIN_MODE=release
TZ=Asia/Taipei
AUTO_MIGRATE=true
AUTO_RECOVER_DIRTY=true
APP_PORT=8080
FRONTEND_PORT=80

# ===== 資料庫 =====
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=請改成自己的密碼
DB_NAME=WeKnora

# ===== Redis =====
STREAM_MANAGER_TYPE=redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=請改成自己的密碼
REDIS_DB=0
REDIS_PREFIX=stream:

# ===== 儲存與檢索 =====
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files
RETRIEVE_DRIVER=postgres

# ===== 安全金鑰（必填）=====
# 用 openssl rand -hex 32 產生
JWT_SECRET=
# 用 openssl rand -hex 16 產生（必須剛好 32 個字元）；設定後不能再改，不然已存的 API key 會解不開
SYSTEM_AES_KEY=
# 用 openssl rand -hex 32 產生
SYSTEM_SIGNING_KEY=

# ===== 只允許連到白名單（建議開啟）=====
# 把公司 LLM API 的網域或網段列進白名單
SSRF_DNS_WHITELIST_ONLY=true
SSRF_WHITELIST=llm.mycompany.com

# ===== 其他 =====
OLLAMA_OPTIONAL=true
WEKNORA_SANDBOX_DOCKER_ENABLED=false
